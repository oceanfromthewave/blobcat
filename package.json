{
    "name": "cat-pet-statusbar",
    "displayName": "BlobCat - Status Bar Pet 🐱",
    "description": "Just blobcat in status bar 🐱 minimal cute vscode pet",
    "version": "1.0.7",
    "publisher": "blobcat",
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "blobcat",
        "cat",
        "statusbar",
        "vscode",
        "pet",
        "cute",
        "fun",
        "extension"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "cat-pet.install",
                "title": "Cat Pet: Install Status Bar Pet"
            },
            {
                "command": "cat-pet.uninstall",
                "title": "Cat Pet: Remove Status Bar Pet"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^16.18.126",
        "@types/vscode": "^1.75.0",
        "typescript": "^4.9.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/oceanfromthewave/blobcat"
    },
    "license": "MIT"
}
